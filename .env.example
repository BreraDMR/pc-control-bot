# Скопируй в .env и заполни. Файл .env в git НЕ попадает.

# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Telegram ID «железных» владельцев через запятую (полный доступ, удалить нельзя).
# Свой ID можно узнать у @userinfobot
OWNER_IDS=11111111,22222222

# Дистрибутив WSL с docker (пусто = дистрибутив по умолчанию)
WSL_DISTRO=

# Интервал авто-снимков вебки в минутах (по умолчанию 30; переключается кнопкой)
AUTO_SNAP_MINUTES=30
